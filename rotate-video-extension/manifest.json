{
  "manifest_version": 3,
  "name": "Rotate Videos",
  "version": "1.0",
  "description": "Rotate all videos on the page by 90 degrees",
  "permissions": ["scripting"],  // removed activeTab from here
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Rotate Videos"
  },
  "commands": {
    "rotate_videos": {
      "suggested_key": {
        "default": "Ctrl+Shift+Right"
      },
      "description": "Rotate videos 90 degrees clockwise"
    }
  }
}

